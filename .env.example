# 容器内 SQLite 路径（挂载命名卷 cdcwater-data）
CDCWATER_DB=/data/cdcwater.sqlite
# 样例目录：镜像内的 /app/sample_data
CDCWATER_SAMPLE_DIR=/app/sample_data
# 迟到窗口（分钟）：水位线 = 最大 event_time − 窗口
CDCWATER_LATE_WINDOW=10
# 时钟保护容差（分钟）：event_time 超前参考时刻超过该值 → 整条暂缓（不进水/快照）
CDCWATER_FUTURE_TOLERANCE=10
# 参考时刻（UTC ISO8601）：留空用运行墙钟；固定它可复算「未来时间」判定
# CDCWATER_REFERENCE_NOW=2026-11-15T09:10:00Z
# 首次启动是否用样例跑一次采信：1 开 / 0 关（关掉后页面是空态，便于演示从零采信）
CDCWATER_SEED=1
